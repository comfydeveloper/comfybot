# ComfyBot Gateway Configuration
# Copy this file to the bin\Debug\net10.0 folder as '.env' and fill in your values
# The .env file is git-ignored to keep credentials secure

# Twitch Configuration
# Gateway__TwitchChannel: The Twitch channel to connect to (e.g., "yourchannelname")
Gateway__TwitchChannel=

# Gateway__TwitchUser: The bot's Twitch username
Gateway__TwitchUser=

# Gateway__TwitchAuthKey: OAuth token for Twitch authentication (get from https://twitchapps.com/tmi/)
# Format: oauth:your_token_here
Gateway__TwitchAuthKey=

# Redis Configuration
# Gateway__RedisConnectionString: Connection string for Redis server
Gateway__RedisConnectionString=localhost:6379
